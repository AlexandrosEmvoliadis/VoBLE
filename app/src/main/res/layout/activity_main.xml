<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- top bar: connect + identity exchange -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="6dp" android:background="#37474F">
        <Button android:id="@+id/connectButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="CONNECT"/>
        <Button android:id="@+id/scanQrButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="SCAN"/>
        <Button android:id="@+id/showQrButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="MY QR"/>
    </LinearLayout>

    <TextView android:id="@+id/statusText" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="6dp" android:text="Ready"
        android:textSize="12sp"/>

    <ImageView android:id="@+id/qrImage" android:layout_width="160dp"
        android:layout_height="160dp" android:layout_gravity="center" android:visibility="gone"/>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/chatList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:padding="4dp"/>

    <!-- bottom bar: record + send -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="6dp" android:background="#37474F">
        <Button android:id="@+id/recordButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="● REC"/>
        <Button android:id="@+id/sendButton" android:layout_width="0dp"
            android:layout_weight="1" android:layout_height="wrap_content" android:text="SEND"/>
    </LinearLayout>
</LinearLayout>
