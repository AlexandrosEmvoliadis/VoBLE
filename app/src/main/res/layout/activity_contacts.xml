<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="10dp" android:background="#00695C">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="Chats" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold"/>
        <Button android:id="@+id/myQrButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="MY QR"/>
        <Button android:id="@+id/addContactButton" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="+ ADD"/>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView android:id="@+id/contactsList"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
</LinearLayout>
